{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indus-kernel.dev/schemas/model_card/v1",
  "title": "ModelCard",
  "description": "Hugging Face model card standard + kernel extensions",
  "type": "object",
  "required": ["id", "provider", "name", "version", "capabilities", "context_length", "license"],
  "properties": {
    "id": {"type": "string", "description": "e.g. 'openai/gpt-5'"},
    "provider": {"type": "string"},
    "name": {"type": "string"},
    "version": {"type": "string"},
    "capabilities": {
      "type": "array",
      "items": {"type": "string"},
      "description": "e.g. 'code', 'math', 'vision', 'json-mode', 'tool-use'"
    },
    "cost_per_1k_input_tokens_cents": {"type": "integer"},
    "cost_per_1k_output_tokens_cents": {"type": "integer"},
    "context_length": {"type": "integer"},
    "license": {"type": "string"},
    "model_card_uri": {"type": "string", "format": "uri"},
    "status": {"type": "string", "enum": ["active", "deprecated", "retired"]},
    "health": {"type": "string", "enum": ["healthy", "degraded", "down"]},
    "metadata": {"type": "object"},
    "benchmark_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["benchmark", "score"],
        "properties": {
          "benchmark": {"type": "string"},
          "score": {"type": "number"},
          "version": {"type": "string"},
          "measured_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
