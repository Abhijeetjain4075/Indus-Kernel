{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indus-kernel.dev/schemas/workflow_state/v1",
  "title": "WorkflowState",
  "type": "object",
  "required": ["workflow_id", "run_id", "status"],
  "properties": {
    "workflow_id": {"type": "string"},
    "run_id": {"type": "string", "format": "uuid"},
    "status": {
      "type": "string",
      "enum": ["running", "completed", "failed", "cancelled", "timed_out", "paused"]
    },
    "current_step": {"type": "string"},
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "started_at"],
        "properties": {
          "step": {"type": "string"},
          "status": {"type": "string"},
          "started_at": {"type": "string", "format": "date-time"},
          "completed_at": {"type": "string", "format": "date-time"},
          "result": {"type": "object"},
          "error": {"type": "string"}
        }
      }
    },
    "variables": {"type": "object"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"}
  }
}
